// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Role is a plain string ("ADMIN" | "STUDENT") instead of a native enum so the
// schema ports cleanly to Postgres later without touching this file.

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  role         String        @default("STUDENT")
  // Manually toggled by an admin for now (see /admin/users); set
  // automatically once a payment gateway is wired up. Grants access to
  // tests where Test.isFreePreview is false.
  isPremium    Boolean       @default(false)
  // Student profile fields — required at signup for STUDENT accounts
  // (enforced in app validation), left null for seeded ADMIN accounts.
  phone        String?
  college      String?
  course       String?
  targetExam   String?
  createdAt    DateTime      @default(now())
  testsCreated Test[]        @relation("TestCreatedBy")
  attempts     TestAttempt[]
  passwordResetTokens PasswordResetToken[]
}

// Forgot-password flow: a short-lived, single-use token emailed to the
// user. Only the SHA-256 hash is stored — the raw token (in the emailed
// link) is never persisted, so a DB leak alone can't be used to reset
// anyone's password.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Test {
  id              String        @id @default(cuid())
  title           String
  description     String?
  // Which MBA entrance exam this test is modeled on — see MBA_ENTRANCE_EXAMS
  // in src/lib/validation.ts for the allowed values (same list students pick
  // from at registration).
  targetExam      String        @default("MH-CET (MBA)")
  // FULL_LENGTH | SECTIONAL | DIAGNOSTIC - what kind of test this is, used by
  // the type filter on the test lists (see src/lib/test-types.ts).
  testType        String        @default("FULL_LENGTH")
  durationMinutes Int
  published       Boolean       @default(false)
  // Accessible without a premium account. Defaults to false so newly
  // created tests are premium-gated unless an admin opts them into the
  // free tier (see /admin/tests and the bank mock generator).
  isFreePreview   Boolean       @default(false)
  createdById     String
  createdBy       User          @relation("TestCreatedBy", fields: [createdById], references: [id])
  sections        Section[]
  attempts        TestAttempt[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([targetExam])
}

model Section {
  id        String     @id @default(cuid())
  testId    String
  test      Test       @relation(fields: [testId], references: [id], onDelete: Cascade)
  name      String
  order     Int
  questions Question[]
  passages  Passage[]
}

// A passage (or shared instructions/data) that several consecutive questions
// in a section refer back to — e.g. a reading passage with 5 sub-questions,
// or a cloze paragraph with one blank per question.
model Passage {
  id        String     @id @default(cuid())
  sectionId String
  section   Section    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title     String?
  text      String
  questions Question[]
}

model Question {
  id          String   @id @default(cuid())
  sectionId   String
  section     Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  passageId   String?
  passage     Passage? @relation(fields: [passageId], references: [id], onDelete: SetNull)
  order       Int
  text        String
  imageUrl    String?
  explanation String?
  marks       Int      @default(1)
  // Carried over from BankQuestion when a test is generated from the bank;
  // left null for hand-built tests. Powers the results page's "Weak Topics"
  // breakdown — that section is skipped entirely when a test has no topic
  // data at all.
  topic       String?
  subTopic    String?
  options     Option[]
  answers     Answer[]
}

model Option {
  id         String     @id @default(cuid())
  questionId String
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  imageUrl   String?
  isCorrect  Boolean    @default(false)
  order      Int
  answers    Answer[]   @relation("SelectedOption")
}

model TestAttempt {
  id          String    @id @default(cuid())
  testId      String
  test        Test      @relation(fields: [testId], references: [id], onDelete: Cascade)
  studentId   String
  student     User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  // Float: negative marking (e.g. -0.25 per wrong answer) gives fractional
  // scores. totalMarks stays a whole number - it is the sum of question marks.
  score       Float?
  totalMarks  Int?
  answers     Answer[]

  @@index([testId])
  @@index([studentId])
}

model Answer {
  id               String      @id @default(cuid())
  attemptId        String
  attempt          TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId       String
  question         Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionId String?
  selectedOption   Option?     @relation("SelectedOption", fields: [selectedOptionId], references: [id])
  timeSpentSeconds Int         @default(0)

  @@unique([attemptId, questionId])
}
