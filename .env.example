# Supabase Postgres. Locally both can be the session pooler (port 5432).
# On Vercel: DATABASE_URL = transaction pooler (port 6543, add ?pgbouncer=true),
# DIRECT_URL = session pooler / direct (port 5432).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Auth.js - generate with: npx auth secret
AUTH_SECRET=""

# Seed owner account (used once by `npm run db:seed`)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Admin"

# Optional: new-student notification + password-reset emails (Resend)
RESEND_API_KEY=""
ADMIN_NOTIFICATION_EMAIL=""
